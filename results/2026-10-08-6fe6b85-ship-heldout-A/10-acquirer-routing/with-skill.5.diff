+
+func TestEightDigitEntryWinsOverSixDigitEntry(t *testing.T) {
+	r := NewRouter(
+		map[string]string{"40128888": "bin8-acquirer"},
+		map[string]string{"401288": "bin6-acquirer"},
+	)
+	got, err := r.Route(visaPlain, "BRL", 1000)
+	if err != nil || got.Acquirer != "bin8-acquirer" {
+		t.Errorf("got %+v, %v; want acquirer bin8-acquirer", got, err)
+	}
+}
+
+func TestEightDigitEntryWithoutSixDigitEntry(t *testing.T) {
+	r := NewRouter(map[string]string{"40128888": "bin8-acquirer"}, nil)
+	got, err := r.Route(visaPlain, "BRL", 1000)
+	if err != nil || got.Acquirer != "bin8-acquirer" {
+		t.Errorf("got %+v, %v; want acquirer bin8-acquirer", got, err)
+	}
+}
+
+func TestVisaAnyLeadingFour(t *testing.T) {
+	if got := route(t, "4900000000000003", "BRL", 1000); got.Scheme != "visa" {
+		t.Errorf("scheme = %s, want visa", got.Scheme)
+	}
+}
