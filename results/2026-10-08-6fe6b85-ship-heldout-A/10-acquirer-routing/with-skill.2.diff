+// The 8-digit entry must win over the 6-digit entry for the same card.
+func TestEightDigitEntryBeatsSixDigitEntry(t *testing.T) {
+	r := NewRouter(
+		map[string]string{"41111190": "bin8-acq"},
+		map[string]string{"411111": "bin6-acq"},
+	)
+	got, err := r.Route(visaBin8, "BRL", 1000)
+	if err != nil || got.Acquirer != "bin8-acq" {
+		t.Errorf("got %+v, %v; want acquirer bin8-acq", got, err)
+	}
+	// Without a matching 8-digit entry, the 6-digit entry applies.
+	got, err = r.Route(visaBin6Other, "BRL", 1000)
+	if err != nil || got.Acquirer != "bin6-acq" {
+		t.Errorf("got %+v, %v; want acquirer bin6-acq", got, err)
+	}
+	// An 8-digit entry alone, with no 6-digit entry, is used.
+	got, err = NewRouter(map[string]string{"41111190": "bin8-acq"}, nil).Route(visaBin8, "BRL", 1000)
+	if err != nil || got.Acquirer != "bin8-acq" {
+		t.Errorf("got %+v, %v; want acquirer bin8-acq", got, err)
+	}
+}
