+func TestShortCardUsesTables(t *testing.T) {
+	r := NewRouter(nil, map[string]string{"400000": "short"})
+	got, err := r.Route(visa12, "BRL", 1000)
+	if err != nil || got.Acquirer != "short" {
+		t.Errorf("got %+v, %v; want acquirer short", got, err)
+	}
+}
+
+func TestOtherWhitespaceIsInvalid(t *testing.T) {
+	for _, card := range []string{"4012888800000008\n", "4012\t8888 0000 0008", "４０１２８８８８０００００００８"} {
+		if err := routeErr(card, "BRL", 1000); !errors.Is(err, ErrInvalidCard) {
+			t.Errorf("card %q: err = %v, want ErrInvalidCard", card, err)
+		}
+	}
+}
+
+func TestMastercard53And55(t *testing.T) {
+	for _, card := range []string{"5300000000000006", "5500000000000004"} {
+		if got := route(t, card, "BRL", 1000); got.Scheme != "mastercard" {
+			t.Errorf("card %s scheme = %s, want mastercard", card, got.Scheme)
+		}
+	}
+}
