+func TestEightDigitEntryWinsOverSixDigitEntry(t *testing.T) {
+	r := NewRouter(
+		map[string]string{"41111190": "bin8-acq"},
+		map[string]string{"411111": "bin6-acq"},
+	)
+	got, err := r.Route(visaBin8, "BRL", 1000)
+	if err != nil || got.Acquirer != "bin8-acq" {
+		t.Errorf("got %+v, %v; want acquirer bin8-acq", got, err)
+	}
+	// Same six digits, different eight: falls back to the six-digit entry.
+	got, err = r.Route(visaBin6Other, "BRL", 1000)
+	if err != nil || got.Acquirer != "bin6-acq" {
+		t.Errorf("got %+v, %v; want acquirer bin6-acq", got, err)
+	}
+}
+
+func TestEightDigitEntryWithoutSixDigitEntry(t *testing.T) {
+	r := NewRouter(map[string]string{"41111190": "bin8-acq"}, nil)
+	got, err := r.Route(visaBin8, "BRL", 1000)
+	if err != nil || got.Acquirer != "bin8-acq" {
+		t.Errorf("got %+v, %v; want acquirer bin8-acq", got, err)
+	}
+	got, err = r.Route(visaBin6, "BRL", 1000)
+	if err != nil || got.Acquirer != "alpha" {
+		t.Errorf("got %+v, %v; want default alpha", got, err)
+	}
+}
