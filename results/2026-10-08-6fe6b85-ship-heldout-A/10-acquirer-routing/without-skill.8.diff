+
+func TestEightDigitEntryTakesPrecedenceOverSixDigitEntry(t *testing.T) {
+	r := NewRouter(
+		map[string]string{"41111190": "golf"},
+		map[string]string{"411111": "delta"},
+	)
+	got, err := r.Route(visaBin8, "BRL", 1000)
+	if err != nil || got.Acquirer != "golf" {
+		t.Errorf("bin8 match: got %+v, %v; want acquirer golf", got, err)
+	}
+	// Same six digits, but no bin8 entry: falls back to bin6.
+	got, err = r.Route(visaBin6, "BRL", 1000)
+	if err != nil || got.Acquirer != "delta" {
+		t.Errorf("bin6 fallback: got %+v, %v; want acquirer delta", got, err)
+	}
+}
+
+func TestEightDigitEntryWithoutSixDigitEntry(t *testing.T) {
+	r := NewRouter(map[string]string{"41111190": "golf"}, nil)
+	got, err := r.Route(visaBin8, "BRL", 1000)
+	if err != nil || got.Acquirer != "golf" {
+		t.Errorf("got %+v, %v; want acquirer golf", got, err)
+	}
+	got, err = r.Route(visaBin6, "BRL", 1000)
+	if err != nil || got.Acquirer != "alpha" {
+		t.Errorf("got %+v, %v; want default alpha", got, err)
+	}
+}
+
+func TestMastercardUpperBoundary(t *testing.T) {
+	for _, card := range []string{"5300000000000006", "5500000000000004"} {
+		if got := route(t, card, "BRL", 1000); got.Scheme != "mastercard" {
+			t.Errorf("card %s scheme = %s, want mastercard", card, got.Scheme)
+		}
+	}
+}
