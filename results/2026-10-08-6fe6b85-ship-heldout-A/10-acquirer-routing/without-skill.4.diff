+func TestEightDigitEntryTakesPrecedenceOverSixDigit(t *testing.T) {
+	r := NewRouter(
+		map[string]string{"41111190": "golf", "40128888": "hotel"},
+		map[string]string{"411111": "delta"},
+	)
+	cases := []struct{ card, acquirer string }{
+		{visaBin8, "golf"},       // both tables match: bin8 wins
+		{visaBin6Other, "delta"}, // only bin6 matches
+		{visaPlain, "hotel"},     // only bin8 matches
+		{visaBin6, "delta"},      // bin6 matches, bin8 has a different 8-digit key
+	}
+	for _, c := range cases {
+		got, err := r.Route(c.card, "BRL", 1000)
+		if err != nil || got.Acquirer != c.acquirer {
+			t.Errorf("card %s = %+v, %v; want acquirer %s", c.card, got, err, c.acquirer)
+		}
+	}
+}
