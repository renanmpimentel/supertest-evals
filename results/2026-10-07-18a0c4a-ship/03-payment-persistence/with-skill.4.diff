 package payments
 
 import (
+	"database/sql"
 	"encoding/json"
 	"net/http"
 	"net/http/httptest"
@@ -50,3 +51,102 @@ func TestCreatePaymentRejectsInvalidAmount(t *testing.T) {
 		t.Fatalf("status = %d, want %d", rec.Code, http.StatusBadRequest)
 	}
 }
+
+func post(t *testing.T, db *sql.DB, body string) *httptest.ResponseRecorder {
+	t.Helper()
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodPost, "/payments", strings.NewReader(body))
+	(&Handler{DB: db}).ServeHTTP(rec, req)
+	return rec
+}
+
+// countRows reads through an independent connection to the same file.
+func countRows(t *testing.T, path string) int {
+	t.Helper()
+	reader, err := sql.Open("sqlite", path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Close()
+	var n int
+	if err := reader.QueryRow(`SELECT COUNT(*) FROM payments`).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	return n
+}
+
+func TestCreatePaymentPersistsCommittedRow(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "payments.db")
+	db, err := OpenDB(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+
+	rec := post(t, db, `{"amount_cents": 5000}`)
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("status = %d, want 201", rec.Code)
+	}
+	var body createResponse
+	if err := json.NewDecoder(rec.Body).Decode(&body); err != nil {
+		t.Fatal(err)
+	}
+
+	reader, err := sql.Open("sqlite", path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Close()
+	var amount int64
+	if err := reader.QueryRow(`SELECT amount_cents FROM payments WHERE id = ?`, body.ID).Scan(&amount); err != nil {
+		t.Fatalf("payment %q not found in database: %v", body.ID, err)
+	}
+	if amount != 5000 {
+		t.Errorf("stored amount = %d, want 5000", amount)
+	}
+}
+
+func TestCreatePaymentAcceptsSmallestPositiveAmount(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "payments.db")
+	db, err := OpenDB(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+
+	if rec := post(t, db, `{"amount_cents": 1}`); rec.Code != http.StatusCreated {
+		t.Fatalf("status = %d, want 201", rec.Code)
+	}
+	if n := countRows(t, path); n != 1 {
+		t.Errorf("rows = %d, want 1", n)
+	}
+}
+
+func TestCreatePaymentRejectsBadInputWithoutSaving(t *testing.T) {
+	cases := map[string]string{
+		"zero":       `{"amount_cents": 0}`,
+		"negative":   `{"amount_cents": -1}`,
+		"missing":    `{}`,
+		"malformed":  `{"amount_cents": `,
+		"not json":   `nope`,
+		"wrong type": `{"amount_cents": "5"}`,
+		"empty":      ``,
+	}
+	for name, body := range cases {
+		t.Run(name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "payments.db")
+			db, err := OpenDB(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer db.Close()
+
+			if rec := post(t, db, body); rec.Code != http.StatusBadRequest {
+				t.Fatalf("status = %d, want 400", rec.Code)
+			}
+			if n := countRows(t, path); n != 0 {
+				t.Errorf("rows = %d, want 0", n)
+			}
+		})
+	}
+}
