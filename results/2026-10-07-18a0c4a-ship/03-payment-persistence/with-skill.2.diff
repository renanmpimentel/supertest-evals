+func post(t *testing.T, db *sql.DB, body string) *httptest.ResponseRecorder {
+	t.Helper()
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodPost, "/payments", strings.NewReader(body))
+	(&Handler{DB: db}).ServeHTTP(rec, req)
+	return rec
+}
+
+func countPayments(t *testing.T, path string) int {
+	t.Helper()
+	reader, err := sql.Open("sqlite", path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Close()
+	var n int
+	if err := reader.QueryRow(`SELECT COUNT(*) FROM payments`).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	return n
+}
+
+func TestCreatePaymentPersistsCommitted(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "payments.db")
+	db, err := OpenDB(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+
+	rec := post(t, db, `{"amount_cents": 5000}`)
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("status = %d, want 201", rec.Code)
+	}
+	var body createResponse
+	if err := json.NewDecoder(rec.Body).Decode(&body); err != nil {
+		t.Fatal(err)
+	}
+
+	// Independent connection: only committed rows are visible.
+	reader, err := sql.Open("sqlite", path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Close()
+	var amount int64
+	if err := reader.QueryRow(`SELECT amount_cents FROM payments WHERE id = ?`, body.ID).Scan(&amount); err != nil {
+		t.Fatalf("payment %q not found in database: %v", body.ID, err)
+	}
+	if amount != 5000 {
+		t.Errorf("stored amount = %d, want 5000", amount)
+	}
+}
+
+func TestCreatePaymentBoundaryAndRejections(t *testing.T) {
+	cases := []struct {
+		name, body string
+		want       int
+		saved      int
+	}{
+		{"smallest valid", `{"amount_cents": 1}`, http.StatusCreated, 1},
+		{"zero", `{"amount_cents": 0}`, http.StatusBadRequest, 0},
+		{"negative", `{"amount_cents": -1}`, http.StatusBadRequest, 0},
+		{"malformed json", `{"amount_cents":`, http.StatusBadRequest, 0},
+		{"empty body", ``, http.StatusBadRequest, 0},
+		{"wrong type", `{"amount_cents": "5"}`, http.StatusBadRequest, 0},
+		{"missing field", `{}`, http.StatusBadRequest, 0},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "payments.db")
+			db, err := OpenDB(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer db.Close()
+			if rec := post(t, db, c.body); rec.Code != c.want {
+				t.Errorf("status = %d, want %d", rec.Code, c.want)
+			}
+			if n := countPayments(t, path); n != c.saved {
+				t.Errorf("saved rows = %d, want %d", n, c.saved)
+			}
+		})
+	}
+}
