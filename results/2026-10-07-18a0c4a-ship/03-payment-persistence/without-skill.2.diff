 package payments
 
 import (
+	"database/sql"
 	"encoding/json"
 	"net/http"
 	"net/http/httptest"
@@ -50,3 +51,99 @@ func TestCreatePaymentRejectsInvalidAmount(t *testing.T) {
 		t.Fatalf("status = %d, want %d", rec.Code, http.StatusBadRequest)
 	}
 }
+
+func post(t *testing.T, db *sql.DB, body string) *httptest.ResponseRecorder {
+	t.Helper()
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodPost, "/payments", strings.NewReader(body))
+	(&Handler{DB: db}).ServeHTTP(rec, req)
+	return rec
+}
+
+func countRows(t *testing.T, db *sql.DB) int {
+	t.Helper()
+	var n int
+	if err := db.QueryRow(`SELECT COUNT(*) FROM payments`).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	return n
+}
+
+// 201 means the payment is committed: visible after closing and reopening the database.
+func TestCreatePaymentIsPersisted(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "payments.db")
+	db, err := OpenDB(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	rec := post(t, db, `{"amount_cents": 1234}`)
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("status = %d, want 201", rec.Code)
+	}
+	var body createResponse
+	if err := json.NewDecoder(rec.Body).Decode(&body); err != nil {
+		t.Fatal(err)
+	}
+	db.Close()
+
+	db2, err := OpenDB(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db2.Close()
+	var amount int64
+	if err := db2.QueryRow(`SELECT amount_cents FROM payments WHERE id = ?`, body.ID).Scan(&amount); err != nil {
+		t.Fatalf("payment %q not found after reopen: %v", body.ID, err)
+	}
+	if amount != 1234 {
+		t.Errorf("stored amount = %d, want 1234", amount)
+	}
+	if n := countRows(t, db2); n != 1 {
+		t.Errorf("rows = %d, want 1", n)
+	}
+}
+
+func TestCreatePaymentDistinctIDs(t *testing.T) {
+	db, err := OpenDB(filepath.Join(t.TempDir(), "payments.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	ids := map[string]bool{}
+	for i := 0; i < 5; i++ {
+		var body createResponse
+		json.NewDecoder(post(t, db, `{"amount_cents": 1}`).Body).Decode(&body)
+		ids[body.ID] = true
+	}
+	if len(ids) != 5 || countRows(t, db) != 5 {
+		t.Errorf("ids = %d, rows = %d, want 5 and 5", len(ids), countRows(t, db))
+	}
+}
+
+func TestInvalidRequestsReturn400AndSaveNothing(t *testing.T) {
+	cases := map[string]string{
+		"zero":          `{"amount_cents": 0}`,
+		"negative":      `{"amount_cents": -5}`,
+		"missing":       `{}`,
+		"malformed":     `{"amount_cents": `,
+		"empty body":    ``,
+		"wrong type":    `{"amount_cents": "100"}`,
+		"fractional":    `{"amount_cents": 1.5}`,
+		"not an object": `[1]`,
+	}
+	for name, body := range cases {
+		t.Run(name, func(t *testing.T) {
+			db, err := OpenDB(filepath.Join(t.TempDir(), "payments.db"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer db.Close()
+			if rec := post(t, db, body); rec.Code != http.StatusBadRequest {
+				t.Errorf("status = %d, want 400", rec.Code)
+			}
+			if n := countRows(t, db); n != 0 {
+				t.Errorf("rows = %d, want 0", n)
+			}
+		})
+	}
+}
