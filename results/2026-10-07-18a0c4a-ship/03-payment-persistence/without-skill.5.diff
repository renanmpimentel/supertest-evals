 package payments
 
 import (
+	"database/sql"
 	"encoding/json"
 	"net/http"
 	"net/http/httptest"
@@ -50,3 +51,105 @@ func TestCreatePaymentRejectsInvalidAmount(t *testing.T) {
 		t.Fatalf("status = %d, want %d", rec.Code, http.StatusBadRequest)
 	}
 }
+
+func newTestDB(t *testing.T) *sql.DB {
+	t.Helper()
+	db, err := OpenDB(filepath.Join(t.TempDir(), "payments.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { db.Close() })
+	return db
+}
+
+func countPayments(t *testing.T, db *sql.DB) int {
+	t.Helper()
+	var n int
+	if err := db.QueryRow(`SELECT COUNT(*) FROM payments`).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	return n
+}
+
+func post(db *sql.DB, body string) *httptest.ResponseRecorder {
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodPost, "/payments", strings.NewReader(body))
+	(&Handler{DB: db}).ServeHTTP(rec, req)
+	return rec
+}
+
+func TestCreatePaymentIsPersistedAndCommitted(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "payments.db")
+	db, err := OpenDB(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	rec := post(db, `{"amount_cents": 5000}`)
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("status = %d, want 201", rec.Code)
+	}
+	var body createResponse
+	if err := json.NewDecoder(rec.Body).Decode(&body); err != nil {
+		t.Fatal(err)
+	}
+	db.Close()
+
+	// Reopen from disk through a fresh connection: the row must be committed.
+	db2, err := OpenDB(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db2.Close()
+	var amount int64
+	if err := db2.QueryRow(`SELECT amount_cents FROM payments WHERE id = ?`, body.ID).Scan(&amount); err != nil {
+		t.Fatalf("payment %q not found after 201: %v", body.ID, err)
+	}
+	if amount != 5000 {
+		t.Errorf("stored amount = %d, want 5000", amount)
+	}
+}
+
+func TestCreatePaymentRejectedSavesNothing(t *testing.T) {
+	cases := map[string]string{
+		"zero":         `{"amount_cents": 0}`,
+		"negative":     `{"amount_cents": -5}`,
+		"missing":      `{}`,
+		"malformed":    `{"amount_cents": `,
+		"not json":     `hello`,
+		"empty":        ``,
+		"wrong type":   `{"amount_cents": "abc"}`,
+		"fractional":   `{"amount_cents": 1.5}`,
+	}
+	for name, body := range cases {
+		t.Run(name, func(t *testing.T) {
+			db := newTestDB(t)
+			rec := post(db, body)
+			if rec.Code != http.StatusBadRequest {
+				t.Fatalf("status = %d, want 400", rec.Code)
+			}
+			if n := countPayments(t, db); n != 0 {
+				t.Errorf("rows = %d, want 0", n)
+			}
+		})
+	}
+}
+
+func TestCreatePaymentDistinctIDs(t *testing.T) {
+	db := newTestDB(t)
+	for i := 0; i < 3; i++ {
+		if rec := post(db, `{"amount_cents": 1}`); rec.Code != http.StatusCreated {
+			t.Fatalf("status = %d", rec.Code)
+		}
+	}
+	if n := countPayments(t, db); n != 3 {
+		t.Errorf("rows = %d, want 3", n)
+	}
+}
+
+func TestCreatePaymentDBFailureIsNotCreated(t *testing.T) {
+	db := newTestDB(t)
+	db.Close()
+	if rec := post(db, `{"amount_cents": 100}`); rec.Code == http.StatusCreated {
+		t.Fatal("got 201 although the payment could not be saved")
+	}
+}
