@@ -50,3 +51,107 @@ func TestCreatePaymentRejectsInvalidAmount(t *testing.T) {
 		t.Fatalf("status = %d, want %d", rec.Code, http.StatusBadRequest)
 	}
 }
+
+func post(t *testing.T, path, body string) *httptest.ResponseRecorder {
+	t.Helper()
+	db, err := OpenDB(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodPost, "/payments", strings.NewReader(body))
+	(&Handler{DB: db}).ServeHTTP(rec, req)
+	return rec
+}
+
+// readPayments uses a fresh connection, so only committed rows are visible.
+func readPayments(t *testing.T, path string) map[string]int64 {
+	t.Helper()
+	db, err := sql.Open("sqlite", path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	rows, err := db.Query(`SELECT id, amount_cents FROM payments`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rows.Close()
+	got := map[string]int64{}
+	for rows.Next() {
+		var id string
+		var amt int64
+		if err := rows.Scan(&id, &amt); err != nil {
+			t.Fatal(err)
+		}
+		got[id] = amt
+	}
+	if err := rows.Err(); err != nil {
+		t.Fatal(err)
+	}
+	return got
+}
+
+func TestCreatePaymentPersistsCommittedRow(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "payments.db")
+	rec := post(t, path, `{"amount_cents": 5000}`)
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("status = %d, want 201", rec.Code)
+	}
+	var body createResponse
+	if err := json.NewDecoder(rec.Body).Decode(&body); err != nil {
+		t.Fatal(err)
+	}
+	got := readPayments(t, path)
+	if len(got) != 1 || got[body.ID] != 5000 {
+		t.Fatalf("db rows = %v, want exactly {%s: 5000}", got, body.ID)
+	}
+}
+
+func TestCreatePaymentMinimumValidAmount(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "payments.db")
+	rec := post(t, path, `{"amount_cents": 1}`)
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("status = %d, want 201", rec.Code)
+	}
+	if got := readPayments(t, path); len(got) != 1 {
+		t.Fatalf("db rows = %v, want 1 row", got)
+	}
+}
+
+func TestCreatePaymentRejectsWithoutSaving(t *testing.T) {
+	cases := map[string]string{
+		"zero":           `{"amount_cents": 0}`,
+		"negative":       `{"amount_cents": -1}`,
+		"missing amount": `{}`,
+		"malformed json": `{"amount_cents": `,
+		"empty body":     ``,
+		"wrong type":     `{"amount_cents": "100"}`,
+		"fractional":     `{"amount_cents": 1.5}`,
+	}
+	for name, body := range cases {
+		t.Run(name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "payments.db")
+			rec := post(t, path, body)
+			if rec.Code != http.StatusBadRequest {
+				t.Fatalf("status = %d, want 400", rec.Code)
+			}
+			if got := readPayments(t, path); len(got) != 0 {
+				t.Fatalf("db rows = %v, want none", got)
+			}
+		})
+	}
+}
+
+func TestCreatePaymentGeneratesDistinctIDs(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "payments.db")
+	for i := 0; i < 3; i++ {
+		if rec := post(t, path, `{"amount_cents": 10}`); rec.Code != http.StatusCreated {
+			t.Fatalf("status = %d, want 201", rec.Code)
+		}
+	}
+	if got := readPayments(t, path); len(got) != 3 {
+		t.Fatalf("db rows = %v, want 3 distinct", got)
+	}
+}
