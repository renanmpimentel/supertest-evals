+func TestInvalidRequestsReturn400AndSaveNothing(t *testing.T) {
+	cases := map[string]string{
+		"zero":       `{"amount_cents": 0}`,
+		"negative":   `{"amount_cents": -5}`,
+		"missing":    `{}`,
+		"malformed":  `{"amount_cents": `,
+		"not json":   `hello`,
+		"empty":      ``,
+		"string":     `{"amount_cents": "100"}`,
+		"fractional": `{"amount_cents": 1.5}`,
+		"null":       `{"amount_cents": null}`,
+		"wrong type": `[1,2]`,
+	}
+	for name, body := range cases {
+		t.Run(name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "payments.db")
+			db, err := OpenDB(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer db.Close()
+			rec := httptest.NewRecorder()
+			(&Handler{DB: db}).ServeHTTP(rec, httptest.NewRequest(http.MethodPost, "/payments", strings.NewReader(body)))
+			if rec.Code != http.StatusBadRequest {
+				t.Fatalf("status = %d, want 400", rec.Code)
+			}
+			if n := countPayments(t, path); n != 0 {
+				t.Errorf("rows = %d, want 0", n)
+			}
+		})
+	}
+}
