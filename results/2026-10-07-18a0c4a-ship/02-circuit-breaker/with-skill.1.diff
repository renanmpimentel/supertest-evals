+  it("returns the charge id and passes the amount when the gateway succeeds", async () => {
+    const s = scripted(["ch_1"]);
+    const breaker = new GatewayBreaker(s.gateway, 3);
     expect(await breaker.charge(1000)).toEqual({ ok: true, chargeId: "ch_1" });
+    expect(s.calls).toEqual([1000]);
+  });
+
+  it("returns the gateway error message while the circuit is closed", async () => {
+    const s = scripted([boom()]);
+    const breaker = new GatewayBreaker(s.gateway, 3);
+    expect(await breaker.charge(1)).toEqual({ ok: false, message: "boom" });
+    expect(breaker.isOpen()).toBe(false);
   });
 
