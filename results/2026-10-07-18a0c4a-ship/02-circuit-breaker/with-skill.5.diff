diff --git a/tests/breaker.test.ts b/tests/breaker.test.ts
index 9d2c6b9..05cdd9a 100644
--- a/tests/breaker.test.ts
+++ b/tests/breaker.test.ts
@@ -22,4 +22,63 @@ describe("GatewayBreaker", () => {
     const result = await breaker.charge(1000);
     expect(result).toEqual({ ok: false, message: FALLBACK_MESSAGE });
   });
+
+  function scripted(outcomes: Array<string | Error>) {
+    const calls: number[] = [];
+    const gateway = {
+      async charge(amount: number): Promise<string> {
+        calls.push(amount);
+        const next = outcomes[calls.length - 1];
+        if (next instanceof Error) throw next;
+        return next;
+      },
+    };
+    return { gateway, calls };
+  }
+
+  it("returns the gateway error message while the circuit is closed", async () => {
+    const { gateway } = scripted([new Error("card declined")]);
+    const breaker = new GatewayBreaker(gateway, 3);
+    expect(await breaker.charge(500)).toEqual({ ok: false, message: "card declined" });
+    expect(breaker.isOpen()).toBe(false);
+  });
+
+  it("opens exactly at the threshold, not before", async () => {
+    const { gateway } = scripted([new Error("e1"), new Error("e2"), new Error("e3")]);
+    const breaker = new GatewayBreaker(gateway, 3);
+    await breaker.charge(1);
+    await breaker.charge(1);
+    expect(breaker.isOpen()).toBe(false);
+    await breaker.charge(1);
+    expect(breaker.isOpen()).toBe(true);
+  });
+
+  it("does not call the gateway while open", async () => {
+    const { gateway, calls } = scripted([new Error("a"), new Error("b"), "ch_late"]);
+    const breaker = new GatewayBreaker(gateway, 2);
+    await breaker.charge(1);
+    await breaker.charge(2);
+    const result = await breaker.charge(3);
+    expect(calls).toEqual([1, 2]);
+    expect(result).toEqual({ ok: false, message: FALLBACK_MESSAGE });
+  });
+
+  it("counts only consecutive failures: a success resets the count", async () => {
+    const { gateway } = scripted([
+      new Error("a"), new Error("b"), "ch_ok", new Error("c"), new Error("d"),
+    ]);
+    const breaker = new GatewayBreaker(gateway, 3);
+    await breaker.charge(1);
+    await breaker.charge(1);
+    expect(await breaker.charge(1)).toEqual({ ok: true, chargeId: "ch_ok" });
+    await breaker.charge(1);
+    await breaker.charge(1);
+    expect(breaker.isOpen()).toBe(false);
+  });
+
+  it("passes the amount to the gateway", async () => {
+    const { gateway, calls } = scripted(["ch_1"]);
+    await new GatewayBreaker(gateway, 3).charge(1234);
+    expect(calls).toEqual([1234]);
+  });
 });
