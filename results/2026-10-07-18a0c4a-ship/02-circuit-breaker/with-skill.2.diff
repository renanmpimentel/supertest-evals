     expect(result).toEqual({ ok: false, message: FALLBACK_MESSAGE });
   });
+
+  it("does not call the gateway while open", async () => {
+    const s = scripted([new Error("a"), new Error("b"), new Error("c"), "ch_never"]);
+    const breaker = new GatewayBreaker(s.gateway, 3);
+    for (let i = 0; i < 3; i += 1) await breaker.charge(1);
+    await breaker.charge(2);
+    await breaker.charge(3);
+    expect(s.amounts).toEqual([1, 1, 1]);
+  });
+
+  it("opens exactly at the threshold, not before", async () => {
+    const s = scripted([new Error("a"), new Error("b"), "ch_3"]);
+    const breaker = new GatewayBreaker(s.gateway, 3);
+    await breaker.charge(1);
+    await breaker.charge(1);
+    expect(breaker.isOpen()).toBe(false);
+    expect(await breaker.charge(1)).toEqual({ ok: true, chargeId: "ch_3" });
+  });
+
+  it("honors a custom threshold and defaults to 3", async () => {
+    const one = new GatewayBreaker(unavailable, 1);
+    await one.charge(1);
+    expect(one.isOpen()).toBe(true);
+
+    const def = new GatewayBreaker(unavailable);
+    await def.charge(1);
+    await def.charge(1);
+    expect(def.isOpen()).toBe(false);
+    await def.charge(1);
+    expect(def.isOpen()).toBe(true);
+  });
+
+  it("returns the gateway's own error message while closed", async () => {
+    const s = scripted([new Error("card declined")]);
+    const breaker = new GatewayBreaker(s.gateway, 3);
