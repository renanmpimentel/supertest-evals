+      new Error("a"), new Error("b"), "ok",
+      new Error("c"), new Error("d"), "ok2",
+    ]);
+    const breaker = new GatewayBreaker(s.gateway, 3);
+    await breaker.charge(1);
+    await breaker.charge(1);
+    expect(await breaker.charge(1)).toEqual({ ok: true, chargeId: "ok" });
+    await breaker.charge(1);
+    await breaker.charge(1);
+    expect(breaker.isOpen()).toBe(false);
+    expect(await breaker.charge(1)).toEqual({ ok: true, chargeId: "ok2" });
+  });
