+function scripted(outcomes: Array<string | Error>) {
+  const amounts: number[] = [];
+  return {
+    amounts,
+    gateway: {
+      async charge(amount: number): Promise<string> {
+        amounts.push(amount);
+        const next = outcomes.shift();
+        if (next === undefined) throw new Error("script exhausted");
+        if (next instanceof Error) throw next;
+        return next;
+      },
+    },
+  };
+}
+
 describe("GatewayBreaker", () => {
   it("returns the charge id when the gateway succeeds", async () => {
     const breaker = new GatewayBreaker({ charge: async () => "ch_1" }, 3);
@@ -22,4 +38,63 @@ describe("GatewayBreaker", () => {
