@@ -23,3 +23,76 @@ describe("GatewayBreaker", () => {
     expect(result).toEqual({ ok: false, message: FALLBACK_MESSAGE });
   });
 });
+
+function scripted(outcomes: Array<string | Error>) {
+  let calls = 0;
+  return {
+    get calls() {
+      return calls;
+    },
+    async charge(): Promise<string> {
+      const next = outcomes[calls++];
+      if (next instanceof Error) throw next;
+      return next;
+    },
+  };
+}
+
+describe("GatewayBreaker contract", () => {
+  it("returns the gateway error message while the circuit is closed", async () => {
+    const gateway = scripted([new Error("card declined")]);
+    const breaker = new GatewayBreaker(gateway, 3);
+    expect(await breaker.charge(500)).toEqual({ ok: false, message: "card declined" });
+    expect(breaker.isOpen()).toBe(false);
+  });
+
+  it("opens exactly at the threshold, not before", async () => {
+    const gateway = scripted([new Error("e1"), new Error("e2"), new Error("e3")]);
+    const breaker = new GatewayBreaker(gateway, 3);
+    await breaker.charge(1);
+    await breaker.charge(1);
+    expect(breaker.isOpen()).toBe(false);
+    expect(await breaker.charge(1)).toEqual({ ok: false, message: "e3" });
+    expect(breaker.isOpen()).toBe(true);
+  });
+
+  it("does not call the gateway once open", async () => {
+    const gateway = scripted([new Error("e1"), new Error("e2"), "ch_never"]);
+    const breaker = new GatewayBreaker(gateway, 2);
+    await breaker.charge(1);
+    await breaker.charge(1);
+    expect(await breaker.charge(1)).toEqual({ ok: false, message: FALLBACK_MESSAGE });
+    expect(gateway.calls).toBe(2);
+  });
+
+  it("passes the amount to the gateway", async () => {
+    const amounts: number[] = [];
+    const breaker = new GatewayBreaker({ charge: async (a) => (amounts.push(a), "ch") }, 3);
+    await breaker.charge(1234);
+    expect(amounts).toEqual([1234]);
+  });
+
+  it("a success resets the consecutive failure count", async () => {
+    const gateway = scripted([
+      new Error("e1"), new Error("e2"), "ch_ok", new Error("e3"), new Error("e4"), "ch_after",
+    ]);
+    const breaker = new GatewayBreaker(gateway, 3);
+    await breaker.charge(1);
+    await breaker.charge(1);
+    expect(await breaker.charge(1)).toEqual({ ok: true, chargeId: "ch_ok" });
+    await breaker.charge(1);
+    await breaker.charge(1);
+    expect(breaker.isOpen()).toBe(false);
+    expect(await breaker.charge(1)).toEqual({ ok: true, chargeId: "ch_after" });
+  });
+
+  it("defaults the threshold to 3", async () => {
+    const gateway = scripted([new Error("a"), new Error("b"), new Error("c"), "x"]);
+    const breaker = new GatewayBreaker(gateway);
+    await breaker.charge(1);
+    await breaker.charge(1);
+    expect(breaker.isOpen()).toBe(false);
+    await breaker.charge(1);
+    expect(breaker.isOpen()).toBe(true);
+  });
+});
