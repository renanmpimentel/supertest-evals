+
+describe("isAllowed permission table", () => {
+  const actions = [
+    "catalog:read",
+    "payment:create",
+    "payment:read",
+    "refund:create",
+    "refund:approve",
+  ];
+  const table: Record<string, string[]> = {
+    guest: ["catalog:read"],
+    user: ["catalog:read", "payment:create", "payment:read"],
+    support: ["catalog:read", "payment:read", "refund:create"],
+    admin: actions,
+  };
+
+  for (const [role, allowed] of Object.entries(table)) {
+    for (const action of actions) {
+      it(`${role} ${allowed.includes(action) ? "may" : "may not"} ${action}`, () => {
+        expect(isAllowed(role, action)).toBe(allowed.includes(action));
+      });
+    }
+  }
+});
