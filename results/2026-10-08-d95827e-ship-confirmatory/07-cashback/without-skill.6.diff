--- a/tests/test_cashback.py
+++ b/tests/test_cashback.py
@@ -57,3 +57,65 @@ def test_rejects_negative_amount():
 def test_rejects_unknown_tier(amount):
     with pytest.raises(CashbackError, match="unknown tier 'gold'"):
         cashback_cents(amount, "gold")
+
+
+@pytest.mark.parametrize(
+    ("amount", "tier", "expected"),
+    [
+        (4_025, "plus", 81),
+        (4_024, "plus", 80),
+        (2_017, "premium", 61),
+        (2_016, "premium", 60),
+        (2_650, "basic", 27),
+        (2_649, "basic", 26),
+    ],
+)
+def test_rounding_per_tier(amount, tier, expected):
+    assert cashback_cents(amount, tier) == expected
+
+
+@pytest.mark.parametrize(
+    ("amount", "tier", "expected"),
+    [
+        (2_450, "basic", 25),
+        (2_549, "basic", 25),
+        (1_250, "plus", 25),
+        (833, "premium", 25),
+        (500, "premium", 25),
+    ],
+)
+def test_minimum_applies_to_every_tier(amount, tier, expected):
+    assert cashback_cents(amount, tier) == expected
+
+
+@pytest.mark.parametrize(
+    ("amount", "tier", "expected"),
+    [
+        (150_000, "plus", 3_000),
+        (149_999, "plus", 3_000),
+        (149_974, "plus", 2_999),
+        (300_000, "basic", 3_000),
+        (299_949, "basic", 2_999),
+        (10_000_000, "plus", 3_000),
+    ],
+)
+def test_maximum_applies_to_every_tier(amount, tier, expected):
+    assert cashback_cents(amount, tier) == expected
+
+
+@pytest.mark.parametrize("tier", ["basic", "plus", "premium"])
+@pytest.mark.parametrize("amount", [-1, -499, -500, -1_000_000])
+def test_rejects_negative_amount_for_every_tier(amount, tier):
+    with pytest.raises(CashbackError):
+        cashback_cents(amount, tier)
+
+
+def test_rejects_negative_amount_with_unknown_tier():
+    with pytest.raises(CashbackError):
+        cashback_cents(-1, "gold")
+
+
+@pytest.mark.parametrize("tier", ["Basic", "", "PLUS", None])
+def test_tier_names_are_exact(tier):
+    with pytest.raises(CashbackError):
+        cashback_cents(10_000, tier)
