diff --git a/tests/test_cashback.py b/tests/test_cashback.py
index 68ac196..3ab46fc 100644
--- a/tests/test_cashback.py
+++ b/tests/test_cashback.py
@@ -57,3 +57,39 @@ def test_rejects_negative_amount():
 def test_rejects_unknown_tier(amount):
     with pytest.raises(CashbackError, match="unknown tier 'gold'"):
         cashback_cents(amount, "gold")
+
+
+@pytest.mark.parametrize("tier", ["basic", "plus", "premium"])
+@pytest.mark.parametrize("amount", [-1, -500, -1_000_000])
+def test_rejects_negative_amount_for_every_tier(tier, amount):
+    with pytest.raises(CashbackError):
+        cashback_cents(amount, tier)
+
+
+@pytest.mark.parametrize("amount", [-1, -10_000])
+def test_negative_amount_with_unknown_tier_raises(amount):
+    with pytest.raises(CashbackError):
+        cashback_cents(amount, "gold")
+
+
+@pytest.mark.parametrize("tier", ["basic", "plus", "premium"])
+def test_minimum_purchase_gets_minimum_for_every_tier(tier):
+    assert cashback_cents(500, tier) == 25
+
+
+def test_rounds_half_up_for_other_tiers():
+    assert cashback_cents(1_250, "plus") == 25  # 25.0
+    assert cashback_cents(3_025, "plus") == 61  # 60.5 -> 61
+    assert cashback_cents(3_024, "plus") == 60  # 60.48
+    assert cashback_cents(5_050, "premium") == 152  # 151.5 -> 152
+
+
+def test_below_minimum_is_raised_to_minimum():
+    assert cashback_cents(2_449, "basic") == 25  # raw 24
+    assert cashback_cents(2_600, "basic") == 26  # raw 26, not clamped
+
+
+def test_just_over_maximum_is_clamped():
+    assert cashback_cents(100_017, "premium") == 3_000  # raw 3001
+    assert cashback_cents(150_000, "plus") == 3_000  # exactly 3000
+    assert cashback_cents(150_100, "plus") == 3_000  # raw 3002
