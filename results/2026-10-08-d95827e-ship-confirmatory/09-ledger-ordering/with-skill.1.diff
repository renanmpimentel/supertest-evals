+def test_same_timestamp_keeps_insertion_order_when_added_out_of_order():
+    ledger = Ledger()
+    ledger.add(10, "credit", 1)
+    ledger.add(5, "credit", 2)
+    ledger.add(10, "debit", 3)
+    ledger.add(5, "debit", 4)
+    assert [e.amount_cents for e in ledger.entries()] == [2, 4, 1, 3]
+
+
+def test_close_day_does_not_change_order():
+    ledger = Ledger()
+    ledger.add(20, "credit", 1)
+    ledger.add(10, "credit", 2)
+    ledger.close_day()
+    assert [e.amount_cents for e in ledger.entries()] == [2, 1]
+
