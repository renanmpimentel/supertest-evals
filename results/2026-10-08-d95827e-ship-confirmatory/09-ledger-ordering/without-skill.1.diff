diff --git a/tests/test_ledger.py b/tests/test_ledger.py
index a1d65c7..a9fe606 100644
--- a/tests/test_ledger.py
+++ b/tests/test_ledger.py
@@ -110,3 +110,49 @@ def test_rejected_entries_are_not_recorded():
             ledger.add(*args)
     assert ledger.entries() == []
     assert ledger.balance() == 0
+
+
+def test_entries_sorted_without_close_day():
+    ledger = Ledger()
+    ledger.add(30, "credit", 100)
+    ledger.add(10, "credit", 200)
+    ledger.add(20, "debit", 50)
+    assert stamps(ledger) == [10, 20, 30]
+
+
+def test_same_timestamp_keeps_insertion_order_when_added_out_of_order():
+    ledger = Ledger()
+    ledger.add(10, "credit", 1)
+    ledger.add(5, "credit", 2)
+    ledger.add(10, "debit", 3)
+    ledger.add(5, "debit", 4)
+    ledger.add(10, "credit", 5)
+    assert [e.amount_cents for e in ledger.entries()] == [2, 4, 1, 3, 5]
+
+
+def test_same_timestamp_order_survives_close_day():
+    ledger = Ledger()
+    for amount in (3, 1, 2):
+        ledger.add(7, "credit", amount)
+    ledger.close_day()
+    assert [e.amount_cents for e in ledger.entries()] == [3, 1, 2]
+
+
+def test_entries_copy_is_independent_of_later_adds():
+    ledger = Ledger()
+    ledger.add(1, "credit", 100)
+    snapshot = ledger.entries()
+    ledger.add(2, "credit", 100)
+    assert len(snapshot) == 1
+    snapshot.append("junk")
+    assert len(ledger.entries()) == 2
+
+
+def test_close_day_does_not_change_balance_or_entries():
+    ledger = Ledger()
+    ledger.add(2, "debit", 40)
+    ledger.add(1, "credit", 100)
+    before = ledger.entries()
+    ledger.close_day()
+    assert ledger.entries() == before
+    assert ledger.balance() == 60
