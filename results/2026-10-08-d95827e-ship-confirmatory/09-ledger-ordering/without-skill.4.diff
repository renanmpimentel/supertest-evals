+
+
+def test_out_of_order_adds_with_ties_keep_insertion_order_within_timestamp():
+    ledger = Ledger()
+    ledger.add(10, "credit", 1)
+    ledger.add(5, "credit", 2)
+    ledger.add(10, "debit", 3)
+    ledger.add(5, "debit", 4)
+    assert [(e.timestamp, e.amount_cents) for e in ledger.entries()] == [
+        (5, 2), (5, 4), (10, 1), (10, 3),
+    ]
+
+
+def test_close_day_does_not_change_entries_or_order():
+    ledger = Ledger()
+    ledger.add(10, "credit", 1)
+    ledger.add(5, "credit", 2)
+    ledger.add(10, "debit", 3)
+    before = ledger.entries()
+    ledger.close_day()
+    assert ledger.entries() == before
+    assert ledger.close_day() == ledger.close_day()
+
+
+def test_close_day_totals_with_only_debits():
+    ledger = Ledger()
+    ledger.add(1, "debit", 70)
+    assert ledger.close_day() == {"count": 1, "credits": 0, "debits": 70, "balance": -70}
