+def test_entries_are_in_timestamp_order_without_closing_the_day():
+    ledger = Ledger()
+    ledger.add(30, "credit", 100)
+    ledger.add(10, "credit", 200)
+    ledger.add(20, "debit", 50)
+    assert stamps(ledger) == [10, 20, 30]
+
+
+def test_same_timestamp_keeps_insertion_order_when_added_out_of_order():
+    ledger = Ledger()
+    ledger.add(10, "credit", 100)
+    ledger.add(5, "credit", 300)
+    ledger.add(10, "debit", 200)
+    ledger.add(5, "debit", 400)
+    assert [e.amount_cents for e in ledger.entries()] == [300, 400, 100, 200]
+
+
