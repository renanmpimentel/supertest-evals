diff --git a/tests/test_ledger.py b/tests/test_ledger.py
index a1d65c7..67951c6 100644
--- a/tests/test_ledger.py
+++ b/tests/test_ledger.py
@@ -110,3 +110,47 @@ def test_rejected_entries_are_not_recorded():
             ledger.add(*args)
     assert ledger.entries() == []
     assert ledger.balance() == 0
+
+
+def test_entries_sorted_without_close_day():
+    ledger = Ledger()
+    ledger.add(30, "credit", 100)
+    ledger.add(10, "credit", 200)
+    ledger.add(20, "debit", 50)
+    assert stamps(ledger) == [10, 20, 30]
+
+
+def test_same_timestamp_keeps_insertion_order_when_added_out_of_order():
+    ledger = Ledger()
+    ledger.add(10, "credit", 1)
+    ledger.add(5, "credit", 2)
+    ledger.add(10, "debit", 3)
+    ledger.add(5, "debit", 4)
+    ledger.add(10, "credit", 5)
+    assert [e.amount_cents for e in ledger.entries()] == [2, 4, 1, 3, 5]
+
+
+def test_close_day_keeps_same_timestamp_order_and_entries():
+    ledger = Ledger()
+    ledger.add(10, "credit", 1)
+    ledger.add(5, "credit", 2)
+    ledger.add(10, "debit", 3)
+    ledger.close_day()
+    assert [e.amount_cents for e in ledger.entries()] == [2, 1, 3]
+    assert ledger.close_day()["count"] == 3
+
+
+def test_close_day_with_unsorted_mixed_entries():
+    ledger = Ledger()
+    ledger.add(3, "debit", 70)
+    ledger.add(1, "credit", 100)
+    ledger.add(2, "debit", 20)
+    assert ledger.close_day() == {"count": 3, "credits": 100, "debits": 90, "balance": 10}
+
+
+def test_rejected_entry_keeps_existing_entries():
+    ledger = Ledger()
+    ledger.add(1, "credit", 100)
+    with pytest.raises(LedgerError):
+        ledger.add(2, "debit", 0)
+    assert ledger.close_day()["count"] == 1
