+def test_out_of_order_adds_with_ties_are_sorted_stably():
+    ledger = Ledger()
+    ledger.add(20, "credit", 1)
+    ledger.add(10, "credit", 2)
+    ledger.add(20, "debit", 3)
+    ledger.add(10, "debit", 4)
+    ledger.add(15, "credit", 5)
+    expected = [(10, 2), (10, 4), (15, 5), (20, 1), (20, 3)]
+    assert [(e.timestamp, e.amount_cents) for e in ledger.entries()] == expected
+    ledger.close_day()
+    assert [(e.timestamp, e.amount_cents) for e in ledger.entries()] == expected
