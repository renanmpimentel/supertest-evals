+// Scripted gateway: each entry is a charge id (success) or an Error (failure).
+function scripted(outcomes: Array<string | Error>) {
+  const calls: number[] = [];
+  return {
+    calls,
+    async charge(amountCents: number): Promise<string> {
+      calls.push(amountCents);
+      const outcome = outcomes[calls.length - 1];
+      if (outcome === undefined) throw new Error("script exhausted");
+      if (outcome instanceof Error) throw outcome;
+      return outcome;
+    },
+  };
+}
+
+const boom = () => new Error("card declined");
 
