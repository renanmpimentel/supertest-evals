     expect(await breaker.charge(1000)).toEqual({ ok: true, chargeId: "ch_1" });
+    expect(gateway.calls).toEqual([1000]);
+  });
+
+  it("returns the gateway error message while the circuit is closed", async () => {
+    const breaker = new GatewayBreaker(scripted([boom()]), 3);
+    expect(await breaker.charge(1000)).toEqual({
+      ok: false,
+      message: "card declined",
+    });
+    expect(breaker.isOpen()).toBe(false);
   });
 
