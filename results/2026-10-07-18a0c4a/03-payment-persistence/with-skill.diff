diff --git a/payments_test.go b/payments_test.go
index 691f584..10edd28 100644
--- a/payments_test.go
+++ b/payments_test.go
@@ -1,6 +1,7 @@
 package payments
 
 import (
+	"database/sql"
 	"encoding/json"
 	"net/http"
 	"net/http/httptest"
@@ -50,3 +51,101 @@ func TestCreatePaymentRejectsInvalidAmount(t *testing.T) {
 		t.Fatalf("status = %d, want %d", rec.Code, http.StatusBadRequest)
 	}
 }
+
+func newTestDB(t *testing.T) (*sql.DB, string) {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "payments.db")
+	db, err := OpenDB(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { db.Close() })
+	return db, path
+}
+
+func post(db *sql.DB, body string) *httptest.ResponseRecorder {
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodPost, "/payments", strings.NewReader(body))
+	(&Handler{DB: db}).ServeHTTP(rec, req)
+	return rec
+}
+
+// countPayments reads through an independent connection, so only committed
+// data is visible.
+func countPayments(t *testing.T, path string) int {
+	t.Helper()
+	reader, err := sql.Open("sqlite", path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Close()
+	var n int
+	if err := reader.QueryRow(`SELECT COUNT(*) FROM payments`).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	return n
+}
+
+func TestCreatePaymentIsPersistedAndCommitted(t *testing.T) {
+	db, path := newTestDB(t)
+
+	rec := post(db, `{"amount_cents": 5000}`)
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("status = %d, want 201", rec.Code)
+	}
+	var body createResponse
+	if err := json.NewDecoder(rec.Body).Decode(&body); err != nil {
+		t.Fatal(err)
+	}
+
+	reader, err := sql.Open("sqlite", path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Close()
+	var amount int64
+	if err := reader.QueryRow(`SELECT amount_cents FROM payments WHERE id = ?`, body.ID).Scan(&amount); err != nil {
+		t.Fatalf("payment %q not found by independent connection: %v", body.ID, err)
+	}
+	if amount != 5000 {
+		t.Errorf("stored amount_cents = %d, want 5000", amount)
+	}
+	if n := countPayments(t, path); n != 1 {
+		t.Errorf("rows = %d, want 1", n)
+	}
+}
+
+func TestCreatePaymentSmallestValidAmount(t *testing.T) {
+	db, path := newTestDB(t)
+	rec := post(db, `{"amount_cents": 1}`)
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("status = %d, want 201", rec.Code)
+	}
+	if n := countPayments(t, path); n != 1 {
+		t.Errorf("rows = %d, want 1", n)
+	}
+}
+
+func TestCreatePaymentRejectsInvalidInputWithoutSaving(t *testing.T) {
+	cases := map[string]string{
+		"zero":           `{"amount_cents": 0}`,
+		"negative":       `{"amount_cents": -1}`,
+		"large negative": `{"amount_cents": -5000}`,
+		"missing field":  `{}`,
+		"malformed json": `{"amount_cents": `,
+		"empty body":     ``,
+		"wrong type":     `{"amount_cents": "100"}`,
+	}
+	for name, body := range cases {
+		t.Run(name, func(t *testing.T) {
+			db, path := newTestDB(t)
+			rec := post(db, body)
+			if rec.Code != http.StatusBadRequest {
+				t.Fatalf("status = %d, want 400", rec.Code)
+			}
+			if n := countPayments(t, path); n != 0 {
+				t.Errorf("rows = %d, want 0 (nothing saved on 400)", n)
+			}
+		})
+	}
+}
