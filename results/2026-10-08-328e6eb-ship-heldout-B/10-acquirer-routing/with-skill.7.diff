+func TestEightDigitEntryTakesPrecedenceOverSixDigitEntry(t *testing.T) {
+	r := NewRouter(
+		map[string]string{"40128888": "golf"},
+		map[string]string{"401288": "hotel"},
+	)
+	got, err := r.Route(visaPlain, "BRL", 1000)
+	if err != nil || got.Acquirer != "golf" {
+		t.Errorf("got %+v, %v; want acquirer golf", got, err)
+	}
+	// Same six digits, different eighth-digit prefix: only the six-digit entry matches.
+	got, err = r.Route("4012881100000000", "BRL", 1000)
+	if err != nil || got.Acquirer != "hotel" {
+		t.Errorf("got %+v, %v; want acquirer hotel", got, err)
+	}
