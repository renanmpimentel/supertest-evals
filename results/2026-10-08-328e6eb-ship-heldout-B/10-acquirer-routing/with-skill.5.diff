+func TestEightDigitEntryTakesPrecedenceOverSixDigitEntry(t *testing.T) {
+	r := NewRouter(
+		map[string]string{"41111190": "golf", "55555500": "hotel"},
+		map[string]string{"411111": "delta", "555555": "echo"},
+	)
+	cases := []struct {
+		card, acquirer string
+	}{
+		{visaBin8, "golf"},        // bin8 and bin6 both match
+		{visaBin6Other, "delta"},  // only bin6 matches
+		{mastercardBin8, "hotel"}, // bin8 and bin6 both match
+		{mastercard51, "bravo"},   // neither matches
+	}
+	for _, c := range cases {
+		got, err := r.Route(c.card, "BRL", 1000)
+		if err != nil || got.Acquirer != c.acquirer {
+			t.Errorf("card %s = %+v, %v; want acquirer %s", c.card, got, err, c.acquirer)
+		}
+	}
+}
+
+func TestEightDigitEntryWithoutSixDigitEntry(t *testing.T) {
+	r := NewRouter(map[string]string{"41111190": "golf"}, nil)
+	got, err := r.Route(visaBin8, "BRL", 1000)
+	if err != nil || got.Acquirer != "golf" {
+		t.Errorf("got %+v, %v; want acquirer golf", got, err)
+	}
+	got, err = r.Route(visaBin6Other, "BRL", 1000)
+	if err != nil || got.Acquirer != "alpha" {
+		t.Errorf("got %+v, %v; want acquirer alpha", got, err)
+	}
+}
