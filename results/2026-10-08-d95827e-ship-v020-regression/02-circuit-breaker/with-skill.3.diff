--- a/tests/breaker.test.ts
+++ b/tests/breaker.test.ts
@@ -23,3 +23,68 @@ describe("GatewayBreaker", () => {
     expect(result).toEqual({ ok: false, message: FALLBACK_MESSAGE });
   });
 });
+
+function scripted(outcomes: Array<string | Error>) {
+  const calls: number[] = [];
+  return {
+    calls,
+    gateway: {
+      async charge(amount: number): Promise<string> {
+        calls.push(amount);
+        const next = outcomes.shift();
+        if (next === undefined) throw new Error("script exhausted");
+        if (next instanceof Error) throw next;
+        return next;
+      },
+    },
+  };
+}
+
+describe("GatewayBreaker contract details", () => {
+  it("passes the amount to the gateway", async () => {
+    const s = scripted(["ch_1"]);
+    await new GatewayBreaker(s.gateway, 3).charge(1234);
+    expect(s.calls).toEqual([1234]);
+  });
+
+  it("returns the gateway error message while closed", async () => {
+    const s = scripted([new Error("card declined")]);
+    const result = await new GatewayBreaker(s.gateway, 3).charge(1);
+    expect(result).toEqual({ ok: false, message: "card declined" });
+  });
+
+  it("stays closed one failure below the threshold", async () => {
+    const s = scripted([new Error("a"), new Error("b"), "ch_3"]);
+    const breaker = new GatewayBreaker(s.gateway, 3);
+    await breaker.charge(1);
+    await breaker.charge(1);
+    expect(breaker.isOpen()).toBe(false);
+    expect(await breaker.charge(1)).toEqual({ ok: true, chargeId: "ch_3" });
+  });
+
+  it("opens exactly at the threshold and stops calling the gateway", async () => {
+    const s = scripted([new Error("a"), new Error("b"), new Error("c"), "ch_4"]);
+    const breaker = new GatewayBreaker(s.gateway, 3);
+    for (let i = 0; i < 3; i += 1) await breaker.charge(1);
+    expect(breaker.isOpen()).toBe(true);
+    expect(await breaker.charge(1)).toEqual({ ok: false, message: FALLBACK_MESSAGE });
+    expect(s.calls).toHaveLength(3);
+  });
+
+  it("honors a custom threshold", async () => {
+    const s = scripted([new Error("a")]);
+    const breaker = new GatewayBreaker(s.gateway, 1);
+    await breaker.charge(1);
+    expect(breaker.isOpen()).toBe(true);
+  });
+
+  it("success resets the consecutive failure count", async () => {
+    const s = scripted([
+      new Error("a"), new Error("b"), "ok",
+      new Error("c"), new Error("d"),
+    ]);
+    const breaker = new GatewayBreaker(s.gateway, 3);
+    for (let i = 0; i < 5; i += 1) await breaker.charge(1);
+    expect(breaker.isOpen()).toBe(false);
+  });
+});
