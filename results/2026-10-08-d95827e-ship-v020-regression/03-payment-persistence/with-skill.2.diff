 package payments
 
 import (
+	"database/sql"
 	"encoding/json"
 	"net/http"
 	"net/http/httptest"
@@ -50,3 +51,109 @@ func TestCreatePaymentRejectsInvalidAmount(t *testing.T) {
 		t.Fatalf("status = %d, want %d", rec.Code, http.StatusBadRequest)
 	}
 }
+
+func newTestDB(t *testing.T) (*sql.DB, string) {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "payments.db")
+	db, err := OpenDB(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { db.Close() })
+	return db, path
+}
+
+func post(t *testing.T, db *sql.DB, body string) *httptest.ResponseRecorder {
+	t.Helper()
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodPost, "/payments", strings.NewReader(body))
+	(&Handler{DB: db}).ServeHTTP(rec, req)
+	return rec
+}
+
+// countRows reads through an independent connection, so only committed data is visible.
+func countRows(t *testing.T, path string) int {
+	t.Helper()
+	reader, err := sql.Open("sqlite", path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Close()
+	var n int
+	if err := reader.QueryRow(`SELECT COUNT(*) FROM payments`).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	return n
+}
+
+func TestCreatePaymentIsPersistedAndCommitted(t *testing.T) {
+	db, path := newTestDB(t)
+	rec := post(t, db, `{"amount_cents": 5000}`)
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("status = %d, want 201", rec.Code)
+	}
+	var body createResponse
+	if err := json.NewDecoder(rec.Body).Decode(&body); err != nil {
+		t.Fatal(err)
+	}
+	reader, err := sql.Open("sqlite", path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Close()
+	var amount int64
+	if err := reader.QueryRow(`SELECT amount_cents FROM payments WHERE id = ?`, body.ID).Scan(&amount); err != nil {
+		t.Fatalf("payment %q not found by independent connection: %v", body.ID, err)
+	}
+	if amount != 5000 {
+		t.Errorf("stored amount = %d, want 5000", amount)
+	}
+}
+
+func TestCreatePaymentBoundaryAmounts(t *testing.T) {
+	tests := []struct {
+		name string
+		body string
+		want int
+	}{
+		{"zero", `{"amount_cents": 0}`, http.StatusBadRequest},
+		{"negative one", `{"amount_cents": -1}`, http.StatusBadRequest},
+		{"one", `{"amount_cents": 1}`, http.StatusCreated},
+		{"two", `{"amount_cents": 2}`, http.StatusCreated},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			db, path := newTestDB(t)
+			rec := post(t, db, tc.body)
+			if rec.Code != tc.want {
+				t.Fatalf("status = %d, want %d", rec.Code, tc.want)
+			}
+			wantRows := 0
+			if tc.want == http.StatusCreated {
+				wantRows = 1
+			}
+			if got := countRows(t, path); got != wantRows {
+				t.Errorf("rows = %d, want %d", got, wantRows)
+			}
+		})
+	}
+}
+
+func TestCreatePaymentRejectsInvalidBodiesWithoutSaving(t *testing.T) {
+	for name, body := range map[string]string{
+		"malformed json": `{"amount_cents": `,
+		"empty body":     ``,
+		"missing amount": `{}`,
+		"wrong type":     `{"amount_cents": "10"}`,
+	} {
+		t.Run(name, func(t *testing.T) {
+			db, path := newTestDB(t)
+			if rec := post(t, db, body); rec.Code != http.StatusBadRequest {
+				t.Fatalf("status = %d, want 400", rec.Code)
+			}
+			if got := countRows(t, path); got != 0 {
+				t.Errorf("rows = %d, want 0", got)
+			}
+		})
+	}
+}
